# Soborbum configuration file

# Server settings
DATABASE_URL=postgresql+psycopg2://soborbum:soborbum@db:5432/soborbum
JWT_SECRET=change-me-in-production
STORAGE_DIR=/app/storage

# Default admin user credentials
ADMIN_EMAIL=admin@soborbum.local
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrator

# AI assistant
ANTHROPIC_API_KEY=
# У каждой задачи своя модель и усилие (см. app/ai/model_profiles.py):
#   чат Марины          — claude-sonnet-5
#   резюме/аналитика/выбор задач — claude-haiku-4-5 (без extended thinking)
#   совет директоров: ведущий — claude-opus-5 (effort medium),
#                     агенты-роли — claude-sonnet-5
#   ежедневные задачи   — claude-sonnet-5 (effort low)
#   еженедельные задачи — claude-sonnet-5 (effort medium)
# AI_MODEL — глобальный рубильник: если отличается от claude-sonnet-5,
# переопределяет модель во всех профилях (усилие остаётся из профиля).
AI_MODEL=claude-sonnet-5
# Точечные переопределения, через запятую: <profile>=<model|пусто>[:<effort>].
# Профили: chat, quick, board_lead, board_agent, daily_job, weekly_job.
# Примеры: AI_MODELS=chat=claude-opus-5,daily_job=:medium
AI_MODELS=
MCP_SERVER_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_REDIRECT_URI=http://127.0.0.1:8005/callback

# Telegram bot (app/telegram)
# TELEGRAM_BOT_TOKEN — из @BotFather. CHAT_ID — id рабочей группы, которую
# слушает бот (обычно отрицательный). Бот должен быть в группе и с
# отключённым privacy mode, иначе не видит сообщения.
TELEGRAM_BOT_TOKEN=
CHAT_ID=
# Секрет для POST /api/telegram/webhook/{secret} — альтернатива запуску
# app.telegram.poller отдельным процессом. Пусто = вебхук выключен.
TELEGRAM_WEBHOOK_SECRET=
# Публичный адрес этого бэкенда (для ссылки-диплинка входа через Telegram).
PUBLIC_BASE_URL=http://localhost:8005
# Куда ежедневная задача пишет в базе знаний и по какой таймзоне считается «вчера».
KB_DAILY_DIR=01_Inbox/Daily
KB_TIMEZONE=Europe/Moscow