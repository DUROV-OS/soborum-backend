DATABASE_URL=postgresql+psycopg2://soborbum:soborbum@db:5432/soborbum

# prod (default) — жёстко падает без безопасных секретов ниже.
# dev — только предупреждение, для локальной разработки.
APP_ENV=prod

# ОБЯЗАТЕЛЬНО. Длинная случайная строка (например `openssl rand -hex 32`).
# Значение "change-me-in-production" и пустое — запрещены в prod.
JWT_SECRET=

# ОБЯЗАТЕЛЬНО для создания первого администратора. Пусто или "admin123" —
# администратор не создаётся (в prod — ошибка старта).
ADMIN_EMAIL=admin@soborbum.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# ОБЯЗАТЕЛЬНО. Явные origin фронтенда через запятую. "*" запрещён.
# Пример: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

STORAGE_DIR=/app/storage

# AI assistant (app/ai) - required for /api/ai to work at all.
# Use a direct Anthropic key (sk-ant-...). Leave ANTHROPIC_BASE_URL empty:
# a relay/proxy strips the MCP connector (betas + mcp_servers) and the
# knowledge base goes dark in chats. Only set it for a proxy you control
# that forwards those verbatim.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-sonnet-5

# Read-only. Живой срез смены/консультанта — только заказы покупателей МойСклад
# (бухгалтерия: суммы, оплаты, отгрузки). Складских остатков и CRM здесь нет.
MOYSKLAD_TOKEN=
# Remote MCP. Redirect must match the URI registered on the OAuth client
# (these servers use Claude's callback). Shift calls read tools only.
MCP_SERVER_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
MOYSKLAD_MCP_URL=
MOYSKLAD_MCP_CLIENT_ID=
MOYSKLAD_MCP_CLIENT_SECRET=
DASHBOARD_MCP_URL=
DASHBOARD_MCP_CLIENT_ID=
DASHBOARD_MCP_CLIENT_SECRET=

# Мессенджер MAX (app/max) - токен веб-сессии с web.max.ru
# (JSON.parse(localStorage.__oneme_auth).token). Пусто - раздел /api/max
# отвечает 503, остальное приложение работает.
MAX_TOKEN=
